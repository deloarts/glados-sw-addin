<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <!--
    UpgradeCode is this product's permanent identity across every version - it must NEVER change,
    or Windows Installer treats a later release as an unrelated product (side-by-side install,
    orphaned SOLIDWORKS/COM registrations left behind, upgrade detection broken). Generated once
    for this project, 2026-09: 890AA905-AFB0-4618-8218-E07983EADEB3.

    Version is bound to the packaged DLL's own file version (see the GladosSwAddinDll File
    element below) rather than restated here, so the MSI's ProductVersion can never drift from
    the assembly it installs - see Properties/AssemblyInfo.cs, the single version source.
  -->
  <!--
    The display name and description are restated from GladosSwAddin/Helpers/AddinInfo.cs (WiX
    cannot read a C# constant); keep the three copies - there, here and AssemblyInfo.cs - equal.
  -->
  <?define ProductName = "GLADOS SOLIDWORKS Add-in" ?>
  <?define ProductDescription = "Compares and edits GLADOS catalogue properties and checks documents before PDM release" ?>
  <?define ProjectUrl = "https://github.com/deloarts/glados-sw-addin" ?>

  <Package
    Name="$(var.ProductName)"
    Manufacturer="DELOARTS"
    Version="!(bind.fileVersion.GladosSwAddinDll)"
    UpgradeCode="890AA905-AFB0-4618-8218-E07983EADEB3"
    Language="1033"
    InstallerVersion="500"
    Scope="perMachine"
    Compressed="yes">

    <!-- AllowSameVersionUpgrades lets a rebuilt MSI of the same version replace the
         installed copy instead of installing a second one beside it. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you need to install this older version." />

    <MediaTemplate EmbedCab="yes" />

    <!-- The GLADOS logo in Apps & features / Add or Remove Programs. Same file the add-in
         embeds as its assembly icon (ApplicationIcon in GladosSwAddin.csproj); the path is
         relative to this project directory. -->
    <Icon Id="GladosLogo.ico" SourceFile="..\GladosSwAddin\Resources\Icons\logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="GladosLogo.ico" />

    <!-- The links and comment Apps & features / Add or Remove Programs shows for the entry. -->
    <Property Id="ARPCOMMENTS" Value="$(var.ProductDescription)" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.ProjectUrl)" />
    <Property Id="ARPHELPLINK" Value="$(var.ProjectUrl)/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="$(var.ProjectUrl)/releases" />

    <!-- .NET Framework 4.8's release value is 528040 (the same scheme covers every 4.5-4.8
         release; NETFRAMEWORK45 is the extension's property name for it regardless of which of
         those releases is actually found) - see
         https://learn.microsoft.com/dotnet/framework/migration-guide/how-to-determine-which-versions-are-installed -->
    <PropertyRef Id="NETFRAMEWORK45" />
    <Launch
      Condition="Installed OR NETFRAMEWORK45 &gt;= 528040"
      Message="$(var.ProductName) requires .NET Framework 4.8 or later. Install it, then run this installer again." />

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="GladosSwAddinComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="DELOARTS">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="GladosSwAddinComponents" Directory="INSTALLFOLDER">
      <!--
        The single merged assembly (see ILRepack.targets) plus every COM registration row it
        needs, authored explicitly to mirror `regasm /codebase` exactly - verified by running
        `regasm /regfile` (no admin rights needed, writes nothing) against the actual merged
        Release DLL and diffing its output against these rows (CI and release.yml repeat that
        diff on every build, see .github/scripts/Test-ComRegistration.ps1). No regasm call and no custom
        action at install time: plain MSI Registry-table rows only, so install/uninstall/repair
        all work through ordinary Windows Installer component servicing.

        GladosTaskPaneControl carried no [ComVisible]/[Guid]/[ProgId] before this installer was
        authored (SolidWorks instantiates it purely by ProgId - SwAddin.cs's CreateTaskpane calls
        ITaskpaneView.AddControl("GladosSwAddin.GladosTaskPaneControl", "")). Those attributes
        were added to Forms/GladosTaskPaneControl.cs specifically so this CLSID is stable; if it
        is ever removed or its Guid changed, every row below for
        {E633F40F-85FC-493F-9DFA-025A154E6A98} must be updated to match.
      -->
      <Component Id="GladosSwAddinDllComponent">
        <File Id="GladosSwAddinDll" Source="$(var.GladosSwAddinDllSourcePath)" KeyPath="yes" />

        <!-- SwAddin : ISwAddin - the COM entry point SOLIDWORKS loads via its Add-in registration
             below. GUID from SwAddin.cs's [Guid("BF78E037-8884-435D-966F-6EAA619F35B0")]. -->
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}" Value="GladosSwAddin.SwAddin" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32" Value="mscoree.dll" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32" Name="ThreadingModel" Value="Both" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32" Name="Class" Value="GladosSwAddin.SwAddin" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32" Name="Assembly" Value="GladosSwAddin, Version=0.1.0.0, Culture=neutral, PublicKeyToken=null" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32" Name="RuntimeVersion" Value="v4.0.30319" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32" Name="CodeBase" Value="file:///[INSTALLFOLDER]GladosSwAddin.dll" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32\0.1.0.0" Name="Class" Value="GladosSwAddin.SwAddin" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32\0.1.0.0" Name="Assembly" Value="GladosSwAddin, Version=0.1.0.0, Culture=neutral, PublicKeyToken=null" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32\0.1.0.0" Name="RuntimeVersion" Value="v4.0.30319" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\InprocServer32\0.1.0.0" Name="CodeBase" Value="file:///[INSTALLFOLDER]GladosSwAddin.dll" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\ProgId" Value="GladosSwAddin.SwAddin" Type="string" />
        <RegistryKey Root="HKCR" Key="CLSID\{BF78E037-8884-435D-966F-6EAA619F35B0}\Implemented Categories\{62C8FE65-4EBB-45e7-B440-6E39B2CDBF29}" ForceCreateOnInstall="yes" />
        <RegistryValue Root="HKCR" Key="GladosSwAddin.SwAddin" Value="GladosSwAddin.SwAddin" Type="string" />
        <RegistryValue Root="HKCR" Key="GladosSwAddin.SwAddin\CLSID" Value="{BF78E037-8884-435D-966F-6EAA619F35B0}" Type="string" />

        <!-- GladosTaskPaneControl - see the added attributes in Forms/GladosTaskPaneControl.cs
             and the block comment above. -->
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}" Value="GladosSwAddin.GladosTaskPaneControl" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32" Value="mscoree.dll" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32" Name="ThreadingModel" Value="Both" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32" Name="Class" Value="GladosSwAddin.GladosTaskPaneControl" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32" Name="Assembly" Value="GladosSwAddin, Version=0.1.0.0, Culture=neutral, PublicKeyToken=null" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32" Name="RuntimeVersion" Value="v4.0.30319" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32" Name="CodeBase" Value="file:///[INSTALLFOLDER]GladosSwAddin.dll" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32\0.1.0.0" Name="Class" Value="GladosSwAddin.GladosTaskPaneControl" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32\0.1.0.0" Name="Assembly" Value="GladosSwAddin, Version=0.1.0.0, Culture=neutral, PublicKeyToken=null" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32\0.1.0.0" Name="RuntimeVersion" Value="v4.0.30319" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\InprocServer32\0.1.0.0" Name="CodeBase" Value="file:///[INSTALLFOLDER]GladosSwAddin.dll" Type="string" />
        <RegistryValue Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\ProgId" Value="GladosSwAddin.GladosTaskPaneControl" Type="string" />
        <RegistryKey Root="HKCR" Key="CLSID\{E633F40F-85FC-493F-9DFA-025A154E6A98}\Implemented Categories\{62C8FE65-4EBB-45e7-B440-6E39B2CDBF29}" ForceCreateOnInstall="yes" />
        <RegistryValue Root="HKCR" Key="GladosSwAddin.GladosTaskPaneControl" Value="GladosSwAddin.GladosTaskPaneControl" Type="string" />
        <RegistryValue Root="HKCR" Key="GladosSwAddin.GladosTaskPaneControl\CLSID" Value="{E633F40F-85FC-493F-9DFA-025A154E6A98}" Type="string" />

        <!-- SOLIDWORKS add-in registration, mirrors SwAddin.cs's [ComRegisterFunction] exactly
             (default value 0 = "not loaded at startup by this key alone"; the separate
             AddInsStartup key below is what actually turns it on for a given user). -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\SOLIDWORKS\AddIns\{BF78E037-8884-435D-966F-6EAA619F35B0}" Value="0" Type="integer" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\SOLIDWORKS\AddIns\{BF78E037-8884-435D-966F-6EAA619F35B0}" Name="Title" Value="$(var.ProductName)" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\SOLIDWORKS\AddIns\{BF78E037-8884-435D-966F-6EAA619F35B0}" Name="Description" Value="$(var.ProductDescription)" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\SOLIDWORKS\AddIns\{BF78E037-8884-435D-966F-6EAA619F35B0}" Name="Icon Path" Value="[INSTALLFOLDER]GladosSwAddin.png" Type="string" />
      </Component>

      <!-- The 16x16 icon SOLIDWORKS' Add-Ins dialog shows ("Icon Path" above). It also carries
           the DLL's own name, the file SOLIDWORKS falls back to when no Icon Path is set. -->
      <Component Id="AddinIconComponent">
        <File Id="AddinIconFile" Source="..\GladosSwAddin\Resources\Icons\GladosSwAddin.png" KeyPath="yes" />
      </Component>

      <!--
        The satellite resource assemblies (de-AT\GladosSwAddin.resources.dll, ...) the build
        writes next to the DLL. ILRepack merges only the main assembly, and the ResourceManager
        finds a culture's strings only in <culture>\GladosSwAddin.resources.dll beside it, so
        without these rows every installed copy shows English whatever language is chosen. The
        wildcard keeps each culture's subfolder and picks up any culture added later.
      -->
      <Files Include="$(var.GladosSwAddinDllSourceDir)**\GladosSwAddin.resources.dll" />

      <!--
        Per-user "load at startup" flag. Split into its own component because it is the only
        HKCU data in this otherwise per-machine package - MSI requires a component's KeyPath to
        be either entirely machine- or entirely user-scoped, and mixing it into
        GladosSwAddinDllComponent (keyed on the file) would make this row's install/repair
        unreliable. This intentionally trips ICE64 ("per-user data in a per-machine package"),
        suppressed in the wixproj; see docs/RELEASE.md for why that's correct here rather than a
        workaround, and what it means for other users on a shared machine at uninstall.
      -->
      <Component Id="GladosSwAddinStartupComponent" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="SOFTWARE\SOLIDWORKS\AddInsStartup\{BF78E037-8884-435D-966F-6EAA619F35B0}" Value="1" Type="integer" KeyPath="yes" />
      </Component>

      <!--
        The add-in's license terms, the third-party notices and the third-party license texts,
        installed next to the add-in. The DELOARTS License requires every recipient to get its
        terms with the software, and the licenses of the embedded components require their texts
        to travel with it as well.
      -->
      <Component Id="LicenseComponent">
        <File Id="LicenseFile" Source="..\LICENSE.md" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNoticesComponent">
        <File Id="ThirdPartyNoticesFile" Source="..\THIRD-PARTY-NOTICES.md" KeyPath="yes" />
      </Component>
      <Files Include="..\licenses\*.txt" Subdirectory="licenses" />
    </ComponentGroup>
  </Fragment>
</Wix>
