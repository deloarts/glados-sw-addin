  <!--
    SOLIDWORKS API interop assemblies. By default they come from the Visiativ.SOLIDWORKS.Interop
    package (Visiativ is the SOLIDWORKS reseller; one package version per SOLIDWORKS major
    release, 33.x = 2025), pinned to the OLDEST SOLIDWORKS version the add-in supports: newer
    releases only add API members, so building against the oldest keeps the add-in loadable on
    every version from that one onward (see docs/RELEASE.md, "upgrading the solidworks interop
    assemblies").

    Fallback: set SolidWorksInteropPath (MSBuild property or environment variable) to a folder
    holding the three SolidWorks.Interop.*.dll files - normally a local installation's
    `SOLIDWORKS Corp\SOLIDWORKS\api\redist` - to build against those instead, e.g. offline or to
    test against a specific service pack. CI always uses the package.

    Either way the interop types are embedded (EmbedInteropTypes), so no SolidWorks.Interop.*
    file ships or is referenced at runtime; CI verifies that on the merged assembly.
  -->
  <ItemGroup Condition=" '$(SolidWorksInteropPath)' == '' ">
    <PackageReference Include="Visiativ.SOLIDWORKS.Interop" Version="33.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- NuGet adds package assemblies as plain references, which would link the interop
       assemblies instead of embedding their types. Embedding is required, not just tidier:
       besides keeping SolidWorks.Interop.* out of the output, it is what makes COM members
       typed as object usable as dynamic, which the code relies on. Package references carry
       no package-id metadata in this classic project, so they are matched by their path. -->
  <Target Name="EmbedSolidWorksInteropTypes" AfterTargets="ResolveNuGetPackageAssets" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Condition="$([System.String]::Copy('%(Reference.Identity)').ToLowerInvariant().Contains('visiativ.solidworks.interop'))">
        <EmbedInteropTypes>True</EmbedInteropTypes>
      </Reference>
    </ItemGroup>
  </Target>
  <!-- NuGet also queues the package's DLLs for copy-to-output on its own; embedded interop
       assemblies are never needed next to GladosSwAddin.dll. -->
  <Target Name="SkipCopyingSolidWorksInterop" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Identity)').ToLowerInvariant().Contains('visiativ.solidworks.interop'))" />
    </ItemGroup>
  </Target>
  <!-- The fallback references are added by a target rather than a conditional ItemGroup: Visual
       Studio's classic project system lists every Reference regardless of its ItemGroup's
       condition, and reported the three as "could not be found" whenever the property is unset.
       Running before ResolveAssemblyReferences, they still reach both builds and IntelliSense. -->
  <Target Name="AddLocalSolidWorksInteropReferences" BeforeTargets="ResolveAssemblyReferences" Condition=" '$(SolidWorksInteropPath)' != '' ">
    <ItemGroup>
      <Reference Include="SolidWorks.Interop.sldworks">
        <HintPath>$(SolidWorksInteropPath)\SolidWorks.Interop.sldworks.dll</HintPath>
        <EmbedInteropTypes>True</EmbedInteropTypes>
        <Private>False</Private>
      </Reference>
      <Reference Include="SolidWorks.Interop.swconst">
        <HintPath>$(SolidWorksInteropPath)\SolidWorks.Interop.swconst.dll</HintPath>
        <EmbedInteropTypes>True</EmbedInteropTypes>
        <Private>False</Private>
      </Reference>
      <Reference Include="SolidWorks.Interop.swpublished">
        <HintPath>$(SolidWorksInteropPath)\SolidWorks.Interop.swpublished.dll</HintPath>
        <EmbedInteropTypes>True</EmbedInteropTypes>
        <Private>False</Private>
      </Reference>
    </ItemGroup>
  </Target>
